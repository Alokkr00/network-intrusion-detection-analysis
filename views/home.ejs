<%- include('partials/header') %>

<div class="container-fluid px-lg-5 py-5">
  
  <!-- Hero Section -->
  <div class="row align-items-center py-4 mb-5">
    <div class="col-lg-7 text-start pe-lg-5">
      
      <div class="d-inline-flex align-items-center gap-2 mb-3">
        <span class="soc-badge badge-glow-cyan"><i class="fas fa-shield-virus"></i> Enterprise Threat Console</span>
        <span class="soc-badge badge-glow-purple"><i class="fas fa-brain"></i> Multi-Model AI/ML</span>
      </div>

      <h1 class="display-4 fw-bold mb-3 text-white">
        Next-Generation Network Intrusion Detection
      </h1>

      <p class="lead text-secondary mb-4" style="font-size: 1.15rem; max-width: 640px;">
        High-throughput packet anomaly detection powered by hybrid machine learning models, correlated with the 
        <span class="text-white fw-semibold">MITRE ATT&CK® Enterprise Framework</span>, delivering sub-second triage telemetry and instant defensive containment playbooks.
      </p>

      <div class="d-flex flex-wrap gap-3 mb-4">
        <a href="/submit" class="btn-soc btn-soc-primary">
          <i class="fas fa-gauge-high"></i> Launch Detection Console
        </a>
        <a href="/csv" class="btn-soc btn-soc-outline-cyan">
          <i class="fas fa-file-csv"></i> Batch CSV Triage
        </a>
        <a href="/parameters" class="btn-soc btn-soc-secondary">
          <i class="fas fa-sliders"></i> Packet Inspector
        </a>
      </div>

      <!-- Quick SOC Telemetry Bar -->
      <div class="d-flex flex-wrap gap-4 pt-3 border-top border-secondary-subtle" style="font-size: 0.85rem;">
        <div>
          <span class="text-secondary d-block">Detection Accuracy</span>
          <span class="text-white fw-bold font-mono" style="color: var(--soc-neon-cyan) !important;">97.6% (NSL-KDD)</span>
        </div>
        <div>
          <span class="text-secondary d-block">Supported Models</span>
          <span class="text-white fw-bold font-mono">KNN, RF, CNN, LSTM</span>
        </div>
        <div>
          <span class="text-secondary d-block">Triage Latency</span>
          <span class="text-white fw-bold font-mono" style="color: var(--soc-emerald-safe) !important;">&lt; 50ms / packet</span>
        </div>
        <div>
          <span class="text-secondary d-block">Containment Playbooks</span>
          <span class="text-white fw-bold font-mono">iptables / sysctl / PS</span>
        </div>
      </div>

    </div>

    <!-- Cyber Radar Visual -->
    <div class="col-lg-5 text-center mt-4 mt-lg-0">
      <div class="soc-card p-4 text-center position-relative overflow-hidden" style="background: radial-gradient(circle at center, rgba(0,240,255,0.08) 0%, rgba(17,24,39,0.95) 75%); min-height: 360px; display: flex; align-items: center; justify-content: center;">
        
        <!-- Radar Ring & Scanner -->
        <div style="position: relative; width: 260px; height: 260px; border-radius: 50%; border: 1px solid rgba(0, 240, 255, 0.3); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 30px rgba(0,240,255,0.1);">
          <div style="position: absolute; width: 190px; height: 190px; border-radius: 50%; border: 1px dashed rgba(0, 240, 255, 0.2);"></div>
          <div style="position: absolute; width: 110px; height: 110px; border-radius: 50%; border: 1px solid rgba(0, 240, 255, 0.2);"></div>
          
          <!-- Crosshairs -->
          <div style="position: absolute; width: 100%; height: 1px; background: rgba(0, 240, 255, 0.2);"></div>
          <div style="position: absolute; height: 100%; width: 1px; background: rgba(0, 240, 255, 0.2);"></div>

          <!-- Central Node -->
          <div style="width: 22px; height: 22px; border-radius: 50%; background: var(--soc-neon-cyan); box-shadow: 0 0 15px var(--soc-neon-cyan);"></div>

          <!-- Detected Nodes -->
          <span class="badge badge-glow-critical" style="position: absolute; top: 40px; right: 40px; font-size: 0.7rem;">DoS T1498</span>
          <span class="badge badge-glow-warning" style="position: absolute; bottom: 50px; left: 30px; font-size: 0.7rem;">Probe T1046</span>
          <span class="badge badge-glow-safe" style="position: absolute; top: 55px; left: 45px; font-size: 0.7rem;">Benign Traffic</span>
        </div>

        <div class="mt-3">
          <small class="font-mono text-secondary"><i class="fas fa-satellite-dish me-1" style="color: var(--soc-neon-cyan);"></i> ACTIVE THREAT SCANNER: SENSORS ENGAGED</small>
        </div>

      </div>
    </div>
  </div>

  <!-- Enterprise Capabilities Grid -->
  <div class="mb-5">
    <div class="text-center mb-4">
      <span class="soc-badge badge-glow-cyan mb-2">Operational Architecture</span>
      <h2 class="text-white">Core Platform Capabilities</h2>
      <p class="text-secondary">Designed for 24/7 Security Operations Center (SOC) defense infrastructure</p>
    </div>

    <div class="row g-4">
      
      <div class="col-md-6 col-lg-3">
        <div class="soc-card h-100 p-4">
          <div class="mb-3 text-info">
            <i class="fas fa-network-wired fa-2x" style="color: var(--soc-neon-cyan);"></i>
          </div>
          <h4 class="text-white">Traffic Normalization</h4>
          <p class="text-secondary" style="font-size: 0.9rem;">
            Deterministic categorical encoding for 70 network services and 11 connection flags with standard MinMax scaling.
          </p>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="soc-card h-100 p-4">
          <div class="mb-3 text-success">
            <i class="fas fa-brain fa-2x" style="color: var(--soc-purple-model);"></i>
          </div>
          <h4 class="text-white">Multi-Model Ensemble</h4>
          <p class="text-secondary" style="font-size: 0.9rem;">
            Cross-verifies predictions across KNN (97.6%), Random Forest (97.4%), CNN (95.8%), and LSTM (95.6%) neural nets.
          </p>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="soc-card h-100 p-4">
          <div class="mb-3 text-danger">
            <i class="fas fa-crosshairs fa-2x" style="color: var(--soc-crimson-critical);"></i>
          </div>
          <h4 class="text-white">MITRE ATT&CK Matrix</h4>
          <p class="text-secondary" style="font-size: 0.9rem;">
            Direct correlation to industry attack tactics (TA0040, TA0007, TA0001, TA0004) with CVSS v3.1 severity scores.
          </p>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="soc-card h-100 p-4">
          <div class="mb-3 text-warning">
            <i class="fas fa-shield-halved fa-2x" style="color: var(--soc-amber-warning);"></i>
          </div>
          <h4 class="text-white">Automated Playbooks</h4>
          <p class="text-secondary" style="font-size: 0.9rem;">
            Surfaces one-click copyable tactical containment commands for iptables, TCP SYN flood mitigation, and account lockdown.
          </p>
        </div>
      </div>

    </div>
  </div>

  <!-- Threat Classification Taxonomy -->
  <div class="soc-card p-4 p-lg-5 mb-5">
    <div class="row align-items-center">
      <div class="col-lg-5 mb-4 mb-lg-0">
        <span class="soc-badge badge-glow-critical mb-2">Threat Intelligence</span>
        <h3 class="text-white mb-3">Target Threat Taxonomies</h3>
        <p class="text-secondary">
          Trained on the benchmark NSL-KDD dataset to classify both binary intrusion states and granular attack categories with high precision.
        </p>
        <a href="/attacks" class="btn-soc btn-soc-outline-cyan">
          <i class="fas fa-book-open"></i> Full MITRE Framework
        </a>
      </div>
      <div class="col-lg-7">
        <div class="row g-3">
          <div class="col-sm-6">
            <div class="p-3 rounded border border-secondary-subtle" style="background: var(--soc-bg-canvas);">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <strong class="text-white">DoS Attacks</strong>
                <span class="badge badge-glow-critical">CRITICAL (P1)</span>
              </div>
              <small class="text-secondary">SYN Flood, Neptune, Smurf, Pod, Teardrop (MITRE T1498)</small>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="p-3 rounded border border-secondary-subtle" style="background: var(--soc-bg-canvas);">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <strong class="text-white">Probe / Recon</strong>
                <span class="badge badge-glow-warning">HIGH (P2)</span>
              </div>
              <small class="text-secondary">Portscan, Satan, IPsweep, Nmap (MITRE T1046)</small>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="p-3 rounded border border-secondary-subtle" style="background: var(--soc-bg-canvas);">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <strong class="text-white">R2L Attacks</strong>
                <span class="badge badge-glow-warning">HIGH (P2)</span>
              </div>
              <small class="text-secondary">Brute-Force, Warezclient, Guess_passwd (MITRE T1078)</small>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="p-3 rounded border border-secondary-subtle" style="background: var(--soc-bg-canvas);">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <strong class="text-white">U2R Attacks</strong>
                <span class="badge badge-glow-critical">SEVERE (P1)</span>
              </div>
              <small class="text-secondary">Buffer Overflow, Rootkit, Loadmodule (MITRE T1068)</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

<%- include('partials/footer') %>