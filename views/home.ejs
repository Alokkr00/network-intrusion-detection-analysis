<%- include('partials/header') %>

<div class="container-fluid px-lg-5 py-5">
  
  <!-- Hero Section -->
  <div class="row align-items-center py-3 mb-5">
    <div class="col-lg-7 text-start pe-lg-5">
      
      <div class="d-inline-flex align-items-center gap-2 mb-3">
        <span class="soc-badge badge-glow-cyan"><i class="fas fa-shield-halved me-1"></i> Open-Source ML Research</span>
        <span class="soc-badge badge-glow-safe"><i class="fas fa-check-circle me-1"></i> 97.6% Benchmark Accuracy</span>
      </div>

      <h1 class="display-5 fw-bold mb-3 text-white">
        Network Intrusion Detection System
      </h1>

      <p class="lead text-secondary mb-4" style="font-size: 1.05rem; max-width: 620px;">
        Empirical packet anomaly detection powered by hybrid machine learning architectures, correlated with the 
        <strong class="text-white">MITRE ATT&CK® Enterprise Matrix</strong> for sub-second classification and tactical defensive containment.
      </p>

      <div class="d-flex flex-wrap gap-3 mb-4">
        <a href="/submit" class="btn-soc btn-soc-primary">
          <i class="fas fa-play"></i> Launch Operations
        </a>
        <a href="/csv" class="btn-soc btn-soc-secondary">
          <i class="fas fa-file-csv"></i> Batch CSV Upload
        </a>
        <a href="/parameters" class="btn-soc btn-soc-outline-cyan">
          <i class="fas fa-sliders"></i> Packet Inspector
        </a>
      </div>

      <!-- Quick Telemetry Specs -->
      <div class="d-flex flex-wrap gap-4 pt-3 border-top border-secondary-subtle" style="font-size: 0.82rem;">
        <div>
          <span class="text-secondary d-block">Top Accuracy</span>
          <span class="text-white fw-semibold font-mono text-sky">97.60% (KNN / RF)</span>
        </div>
        <div>
          <span class="text-secondary d-block">Evaluation Dataset</span>
          <span class="text-white fw-semibold font-mono">NSL-KDD (22.5k Records)</span>
        </div>
        <div>
          <span class="text-secondary d-block">Architectures</span>
          <span class="text-white fw-semibold font-mono">KNN • RF • CNN • LSTM</span>
        </div>
        <div>
          <span class="text-secondary d-block">Inference Engine</span>
          <span class="text-white fw-semibold font-mono text-sky">Multi-Model Ensemble</span>
        </div>
      </div>

    </div>

    <!-- Clean Model Performance Overview Card -->
    <div class="col-lg-5 mt-4 mt-lg-0">
      <div class="soc-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary-subtle">
          <div>
            <h5 class="text-white mb-0">Model Performance</h5>
            <small class="text-secondary">NSL-KDD Test Partition</small>
          </div>
          <a href="/stats" class="btn-soc btn-soc-secondary btn-sm" style="font-size: 0.75rem;">Full Report</a>
        </div>

        <div class="d-flex flex-column gap-3">
          
          <!-- KNN -->
          <div>
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="text-white font-mono" style="font-size: 0.88rem;">K-Nearest Neighbors</span>
              <span class="soc-badge badge-glow-cyan" style="font-size: 0.72rem;">97.60%</span>
            </div>
            <div class="progress" style="height: 6px; background: var(--soc-bg-canvas);">
              <div class="progress-bar" style="width: 97.6%; background: var(--soc-accent-primary);"></div>
            </div>
          </div>

          <!-- Random Forest -->
          <div>
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="text-white font-mono" style="font-size: 0.88rem;">Random Forest (Recommended)</span>
              <span class="soc-badge badge-glow-safe" style="font-size: 0.72rem;">97.41%</span>
            </div>
            <div class="progress" style="height: 6px; background: var(--soc-bg-canvas);">
              <div class="progress-bar" style="width: 97.4%; background: var(--soc-emerald-safe);"></div>
            </div>
          </div>

          <!-- CNN -->
          <div>
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="text-white font-mono" style="font-size: 0.88rem;">1D Convolutional Neural Net</span>
              <span class="soc-badge badge-glow-purple" style="font-size: 0.72rem;">95.82%</span>
            </div>
            <div class="progress" style="height: 6px; background: var(--soc-bg-canvas);">
              <div class="progress-bar" style="width: 95.8%; background: var(--soc-purple-model);"></div>
            </div>
          </div>

          <!-- LSTM -->
          <div>
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="text-white font-mono" style="font-size: 0.88rem;">Recurrent LSTM Network</span>
              <span class="soc-badge badge-glow-warning" style="font-size: 0.72rem;">95.62%</span>
            </div>
            <div class="progress" style="height: 6px; background: var(--soc-bg-canvas);">
              <div class="progress-bar" style="width: 95.6%; background: var(--soc-amber-warning);"></div>
            </div>
          </div>

        </div>

        <div class="mt-3 pt-3 border-top border-secondary-subtle text-secondary" style="font-size: 0.8rem;">
          <i class="fas fa-check-circle text-success me-1"></i> Multi-model consensus validates classifications across classical & deep learning approaches.
        </div>
      </div>
    </div>
  </div>

  <!-- Core Capabilities Grid -->
  <div class="mb-5">
    <div class="text-center mb-4">
      <h2 class="text-white mb-1">Core Capabilities</h2>
      <p class="text-secondary" style="font-size: 0.95rem;">Designed for accurate classification and actionable incident response</p>
    </div>

    <div class="row g-4">
      
      <div class="col-md-6 col-lg-3">
        <div class="soc-card h-100 p-4">
          <div class="mb-3 text-sky">
            <i class="fas fa-network-wired fa-xl"></i>
          </div>
          <h5 class="text-white mb-2">Feature Normalization</h5>
          <p class="text-secondary mb-0" style="font-size: 0.88rem;">
            Standardized preprocessing for 70 network services and 11 connection flags with MinMax normalization.
          </p>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="soc-card h-100 p-4">
          <div class="mb-3" style="color: var(--soc-purple-model);">
            <i class="fas fa-brain fa-xl"></i>
          </div>
          <h5 class="text-white mb-2">Multi-Model Ensemble</h5>
          <p class="text-secondary mb-0" style="font-size: 0.88rem;">
            Simultaneous evaluation across KNN, Random Forest, 1D CNN, and LSTM to prevent model-specific bias.
          </p>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="soc-card h-100 p-4">
          <div class="mb-3" style="color: var(--soc-crimson-critical);">
            <i class="fas fa-crosshairs fa-xl"></i>
          </div>
          <h5 class="text-white mb-2">MITRE ATT&CK Matrix</h5>
          <p class="text-secondary mb-0" style="font-size: 0.88rem;">
            Direct mapping of network anomalies to industry tactics (TA0040, TA0007, TA0001, TA0004) with CVSS scores.
          </p>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="soc-card h-100 p-4">
          <div class="mb-3" style="color: var(--soc-emerald-safe);">
            <i class="fas fa-shield-halved fa-xl"></i>
          </div>
          <h5 class="text-white mb-2">Containment Playbooks</h5>
          <p class="text-secondary mb-0" style="font-size: 0.88rem;">
            Copy-ready mitigation rules including iptables firewall filters and kernel sysctl parameter tuning.
          </p>
        </div>
      </div>

    </div>
  </div>

  <!-- Threat Classification Taxonomy -->
  <div class="soc-card p-4 p-lg-5 mb-5">
    <div class="row align-items-center">
      <div class="col-lg-5 mb-4 mb-lg-0">
        <span class="soc-badge badge-glow-cyan mb-2">Threat Taxonomy</span>
        <h3 class="text-white mb-2">Classified Attack Categories</h3>
        <p class="text-secondary mb-3" style="font-size: 0.92rem;">
          Trained on the NSL-KDD benchmark to differentiate benign traffic from four distinct network attack vectors.
        </p>
        <a href="/attacks" class="btn-soc btn-soc-secondary btn-sm">
          <i class="fas fa-book-open me-1"></i> Full MITRE Framework
        </a>
      </div>
      <div class="col-lg-7">
        <div class="row g-3">
          <div class="col-sm-6">
            <div class="p-3 rounded border border-secondary-subtle" style="background: var(--soc-bg-canvas);">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <strong class="text-white">Denial of Service (DoS)</strong>
                <span class="soc-badge badge-glow-critical" style="font-size: 0.68rem;">Critical</span>
              </div>
              <small class="text-secondary d-block">SYN Flood, Neptune, Smurf, Pod, Teardrop (T1498)</small>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="p-3 rounded border border-secondary-subtle" style="background: var(--soc-bg-canvas);">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <strong class="text-white">Probe / Portscan</strong>
                <span class="soc-badge badge-glow-warning" style="font-size: 0.68rem;">High</span>
              </div>
              <small class="text-secondary d-block">Portscan, Satan, IPsweep, Nmap (T1046)</small>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="p-3 rounded border border-secondary-subtle" style="background: var(--soc-bg-canvas);">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <strong class="text-white">Remote to Local (R2L)</strong>
                <span class="soc-badge badge-glow-warning" style="font-size: 0.68rem;">High</span>
              </div>
              <small class="text-secondary d-block">Brute-Force, Warezclient, Guess_passwd (T1078)</small>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="p-3 rounded border border-secondary-subtle" style="background: var(--soc-bg-canvas);">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <strong class="text-white">User to Root (U2R)</strong>
                <span class="soc-badge badge-glow-critical" style="font-size: 0.68rem;">Severe</span>
              </div>
              <small class="text-secondary d-block">Buffer Overflow, Rootkit, Loadmodule (T1068)</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

<%- include('partials/footer') %>