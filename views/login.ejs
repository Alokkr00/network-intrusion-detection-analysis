<%- include('partials/header') %>

<div class="container-fluid px-lg-5 py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5 col-xl-4">
      
      <div class="soc-card p-4 p-md-5">
        
        <div class="text-center mb-4">
          <div class="d-inline-flex p-3 rounded-circle mb-3" style="background: rgba(0, 240, 255, 0.1); color: var(--soc-neon-cyan);">
            <i class="fas fa-shield-halved fa-2x"></i>
          </div>
          <h2 class="text-white fw-bold mb-1">SOC Console Sign In</h2>
          <p class="text-secondary" style="font-size: 0.9rem;">Authenticate to access intrusion detection operations</p>
        </div>

        <form action="/login" method="POST">
          
          <div class="soc-form-group mb-3">
            <label class="soc-label" for="username">Operator Username / Email:</label>
            <div class="position-relative">
              <input type="text" class="soc-input" id="username" name="username" placeholder="analyst@soc.enterprise" required autocomplete="username">
            </div>
          </div>

          <div class="soc-form-group mb-4">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <label class="soc-label mb-0" for="password">Password:</label>
            </div>
            <input type="password" class="soc-input" id="password" name="password" placeholder="••••••••••••" required autocomplete="current-password">
          </div>

          <button type="submit" class="btn-soc btn-soc-primary w-100 py-2 mb-3 font-weight-bold">
            <i class="fas fa-right-to-bracket"></i> Sign In to Console
          </button>

          <div class="text-center pt-3 border-top border-secondary-subtle">
            <span class="text-secondary" style="font-size: 0.85rem;">New analyst?</span>
            <a href="/register" class="text-info fw-semibold ms-1" style="font-size: 0.85rem; text-decoration: none;">Create Operator Account</a>
          </div>

        </form>

      </div>

    </div>
  </div>
</div>

<%- include('partials/footer') %>