<%- include('partials/header') %>

<div class="container-fluid px-lg-5 py-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5 col-xl-4">
      
      <div class="soc-card p-4 p-md-5">
        
        <div class="text-center mb-4">
          <div class="d-inline-flex p-3 rounded mb-3" style="background: rgba(63, 185, 80, 0.1); color: var(--soc-emerald-safe);">
            <i class="fas fa-user-plus fa-xl"></i>
          </div>
          <h2 class="text-white fw-bold mb-1" style="font-size: 1.45rem;">Create Account</h2>
          <p class="text-secondary" style="font-size: 0.88rem;">Register to save analysis sessions and download reports</p>
        </div>

        <form action="/register" method="POST">
          
          <div class="soc-form-group mb-3">
            <label class="soc-label" for="username">Username or Email</label>
            <input type="text" class="soc-input" id="username" name="username" placeholder="user@example.com" required autocomplete="username">
          </div>

          <div class="soc-form-group mb-4">
            <label class="soc-label" for="password">Password</label>
            <input type="password" class="soc-input" id="password" name="password" placeholder="••••••••••••" required autocomplete="new-password">
            <small class="text-muted d-block mt-1">Minimum 6 characters recommended.</small>
          </div>

          <button type="submit" class="btn-soc btn-soc-primary w-100 py-2 mb-3">
            <i class="fas fa-user-plus me-1"></i> Register Account
          </button>

          <div class="text-center pt-3 border-top border-secondary-subtle">
            <span class="text-secondary" style="font-size: 0.85rem;">Already have an account?</span>
            <a href="/login" class="text-sky fw-medium ms-1" style="font-size: 0.85rem; text-decoration: none;">Sign in</a>
          </div>

        </form>

      </div>

    </div>
  </div>
</div>

<%- include('partials/footer') %>