<%- include('partials/header') %>

<div class="container-fluid px-lg-5 py-5">

  <% const isAttack = (typeof consensus_binary !== 'undefined' && consensus_binary === 'ATTACK') || (typeof p_rf_bin_cls !== 'undefined' && p_rf_bin_cls === 'ATTACK'); %>
  <% const attackCategory = (typeof consensus_multi !== 'undefined' && consensus_multi) ? consensus_multi : (typeof p_rf_mul_cls !== 'undefined' ? p_rf_mul_cls : 'NORMAL'); %>
  <% const mitreData = (typeof mitre !== 'undefined' && mitre) ? mitre : {
      category: attackCategory,
      technique_id: isAttack ? 'T1498' : 'BENIGN-001',
      technique_name: isAttack ? 'Custom Vector Anomaly Detected' : 'Verified Normal Telemetry',
      tactic: isAttack ? 'Impact / Reconnaissance' : 'Routine Operations',
      severity: isAttack ? 'CRITICAL' : 'SAFE',
      cvss_score: isAttack ? '8.6' : '0.0',
      impact: isAttack ? 'Custom injected parameter vector matches known adversarial intrusion signatures.' : 'Custom packet attributes comply with normal protocol baseline thresholds.',
      containment_playbook: isAttack ? ['sudo iptables -I INPUT -s <ATTACKER_IP> -j DROP', 'sudo sysctl -w net.ipv4.tcp_syncookies=1'] : ['# No containment required. Standard telemetry logged.']
  }; %>

  <!-- Header Banner -->
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-3 border-bottom border-secondary-subtle">
    <div>
      <div class="d-inline-flex align-items-center gap-2 mb-2">
        <span class="soc-badge badge-glow-warning"><i class="fas fa-sliders"></i> Custom Parameter Forensics</span>
        <span class="soc-badge <%= isAttack ? 'badge-glow-critical' : 'badge-glow-safe' %>">
          <i class="fas <%= isAttack ? 'fa-triangle-exclamation' : 'fa-circle-check' %>"></i>
          STATUS: <%= isAttack ? 'THREAT IDENTIFIED' : 'BENIGN TRAFFIC' %>
        </span>
      </div>
      <h1 class="display-6 text-white fw-bold mb-1">Packet Inspection Triage</h1>
      <p class="text-secondary mb-0">Custom Layer 4 packet parameters evaluated across 4 machine learning inference engines.</p>
    </div>

    <!-- Overall Consensus KPI -->
    <div class="text-end">
      <div class="p-3 rounded border <%= isAttack ? 'border-danger' : 'border-success' %>" style="background: var(--soc-bg-surface); min-width: 220px;">
        <small class="text-secondary d-block text-uppercase font-mono">Ensemble Consensus</small>
        <span class="fs-4 fw-bold font-mono <%= isAttack ? 'text-danger' : 'text-success' %>">
          <i class="fas <%= isAttack ? 'fa-shield-virus' : 'fa-shield-check' %> me-1"></i>
          <%= attackCategory.toUpperCase() %>
        </span>
        <small class="d-block text-secondary mt-1">Classification: <strong><%= isAttack ? 'ATTACK' : 'NORMAL' %></strong></small>
      </div>
    </div>
  </div>

  <!-- Split-Screen Triage Layout -->
  <div class="row g-4">
    
    <!-- Left Column: Multi-Model Consensus Matrix (6 Columns) -->
    <div class="col-lg-6">
      <div class="soc-card h-100">
        <div class="soc-card-header">
          <h5 class="mb-0 text-white"><i class="fas fa-brain me-2" style="color: var(--soc-purple-model);"></i>Multi-Model Inference Matrix</h5>
          <span class="soc-badge badge-glow-purple" style="font-size: 0.7rem;">4 Models Evaluated</span>
        </div>
        <div class="soc-card-body">
          <div class="row g-3">
            
            <!-- KNN Model -->
            <div class="col-sm-6">
              <div class="p-3 rounded border border-secondary-subtle h-100" style="background: var(--soc-bg-canvas);">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <strong class="text-white">K-Nearest Neighbors</strong>
                  <span class="soc-badge <%= (typeof p_knn_bin_cls !== 'undefined' && p_knn_bin_cls === 'ATTACK') ? 'badge-glow-critical' : 'badge-glow-safe' %>" style="font-size: 0.7rem;">
                    <%= typeof p_knn_bin_cls !== 'undefined' ? p_knn_bin_cls : 'NORMAL' %>
                  </span>
                </div>
                <div class="mb-2 font-mono text-secondary" style="font-size: 0.85rem;">
                  Category: <span class="text-white fw-bold"><%= typeof p_knn_mul_cls !== 'undefined' ? p_knn_mul_cls : 'NORMAL' %></span>
                </div>
                <div class="d-flex justify-content-between text-secondary pt-2 border-top border-secondary-subtle" style="font-size: 0.8rem;">
                  <span>Benchmark Acc:</span>
                  <span class="font-mono text-info"><%= typeof p_knn_bin_acc !== 'undefined' ? (parseFloat(p_knn_bin_acc)*100).toFixed(1) + '%' : '97.6%' %></span>
                </div>
              </div>
            </div>

            <!-- Random Forest Model -->
            <div class="col-sm-6">
              <div class="p-3 rounded border border-secondary-subtle h-100" style="background: var(--soc-bg-canvas);">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <strong class="text-white">Random Forest (Ensemble)</strong>
                  <span class="soc-badge <%= (typeof p_rf_bin_cls !== 'undefined' && p_rf_bin_cls === 'ATTACK') ? 'badge-glow-critical' : 'badge-glow-safe' %>" style="font-size: 0.7rem;">
                    <%= typeof p_rf_bin_cls !== 'undefined' ? p_rf_bin_cls : 'NORMAL' %>
                  </span>
                </div>
                <div class="mb-2 font-mono text-secondary" style="font-size: 0.85rem;">
                  Category: <span class="text-white fw-bold"><%= typeof p_rf_mul_cls !== 'undefined' ? p_rf_mul_cls : 'NORMAL' %></span>
                </div>
                <div class="d-flex justify-content-between text-secondary pt-2 border-top border-secondary-subtle" style="font-size: 0.8rem;">
                  <span>Benchmark Acc:</span>
                  <span class="font-mono text-info"><%= typeof p_rf_bin_acc !== 'undefined' ? (parseFloat(p_rf_bin_acc)*100).toFixed(1) + '%' : '97.4%' %></span>
                </div>
              </div>
            </div>

            <!-- CNN Model -->
            <div class="col-sm-6">
              <div class="p-3 rounded border border-secondary-subtle h-100" style="background: var(--soc-bg-canvas);">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <strong class="text-white">Convolutional Net (CNN)</strong>
                  <span class="soc-badge <%= (typeof p_cnn_bin_cls !== 'undefined' && p_cnn_bin_cls === 'ATTACK') ? 'badge-glow-critical' : 'badge-glow-safe' %>" style="font-size: 0.7rem;">
                    <%= typeof p_cnn_bin_cls !== 'undefined' ? p_cnn_bin_cls : 'NORMAL' %>
                  </span>
                </div>
                <div class="mb-2 font-mono text-secondary" style="font-size: 0.85rem;">
                  Category: <span class="text-white fw-bold"><%= typeof p_cnn_mul_cls !== 'undefined' ? p_cnn_mul_cls : 'NORMAL' %></span>
                </div>
                <div class="d-flex justify-content-between text-secondary pt-2 border-top border-secondary-subtle" style="font-size: 0.8rem;">
                  <span>Benchmark Acc:</span>
                  <span class="font-mono text-info"><%= typeof p_cnn_bin_acc !== 'undefined' ? (parseFloat(p_cnn_bin_acc)*100).toFixed(1) + '%' : '95.8%' %></span>
                </div>
              </div>
            </div>

            <!-- LSTM Model -->
            <div class="col-sm-6">
              <div class="p-3 rounded border border-secondary-subtle h-100" style="background: var(--soc-bg-canvas);">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <strong class="text-white">Recurrent Net (LSTM)</strong>
                  <span class="soc-badge <%= (typeof p_lstm_bin_cls !== 'undefined' && p_lstm_bin_cls === 'ATTACK') ? 'badge-glow-critical' : 'badge-glow-safe' %>" style="font-size: 0.7rem;">
                    <%= typeof p_lstm_bin_cls !== 'undefined' ? p_lstm_bin_cls : 'NORMAL' %>
                  </span>
                </div>
                <div class="mb-2 font-mono text-secondary" style="font-size: 0.85rem;">
                  Category: <span class="text-white fw-bold"><%= typeof p_lstm_mul_cls !== 'undefined' ? p_lstm_mul_cls : 'NORMAL' %></span>
                </div>
                <div class="d-flex justify-content-between text-secondary pt-2 border-top border-secondary-subtle" style="font-size: 0.8rem;">
                  <span>Benchmark Acc:</span>
                  <span class="font-mono text-info"><%= typeof p_lstm_bin_acc !== 'undefined' ? (parseFloat(p_lstm_bin_acc)*100).toFixed(1) + '%' : '95.6%' %></span>
                </div>
              </div>
            </div>

          </div>

          <div class="mt-2 text-secondary" style="font-size: 0.76rem;">
            <i class="fas fa-circle-info text-sky me-1"></i> Benchmark accuracies reflect published empirical evaluation across the NSL-KDD test partition (22,544 records).
          </div>

          <!-- Analyst Observation -->
          <div class="mt-4 p-3 rounded border border-secondary-subtle" style="background: var(--soc-bg-canvas);">
            <small class="text-secondary d-block mb-1 text-uppercase font-mono">Analyst Observation:</small>
            <p class="text-white mb-0" style="font-size: 0.95rem;">
              <%= typeof p_rf_desc !== 'undefined' ? p_rf_desc : 'Custom parameters correspond to baseline network transactions.' %>
            </p>
          </div>

        </div>
        <div class="soc-card-footer d-flex justify-content-between align-items-center">
          <small class="text-secondary">Ensemble Consensus: <strong>Deterministic</strong></small>
          <a href="/stats" class="btn-soc btn-soc-outline-cyan btn-sm"><i class="fas fa-table me-1"></i> Confusion Tables</a>
        </div>
      </div>
    </div>

    <!-- Right Column: MITRE ATT&CK Dossier & Containment Playbook (6 Columns) -->
    <div class="col-lg-6">
      <div class="soc-card h-100 border <%= isAttack ? 'border-danger' : 'border-success' %>">
        <div class="soc-card-header" style="background: <%= isAttack ? 'rgba(239, 68, 68, 0.15)' : 'rgba(16, 185, 129, 0.15)' %>;">
          <div class="d-flex align-items-center gap-2">
            <i class="fas <%= isAttack ? 'fa-crosshairs text-danger' : 'fa-check-double text-success' %>"></i>
            <h5 class="mb-0 text-white">MITRE ATT&CK® Threat Dossier</h5>
          </div>
          <span class="soc-badge <%= isAttack ? 'badge-glow-critical' : 'badge-glow-safe' %>">
            <%= mitreData.severity %>
          </span>
        </div>
        <div class="soc-card-body">

          <!-- Technique & Tactic Grid -->
          <div class="row g-3 mb-3">
            <div class="col-sm-6">
              <div class="p-2 rounded border border-secondary-subtle" style="background: var(--soc-bg-canvas);">
                <small class="text-secondary d-block font-mono">Technique ID</small>
                <span class="text-white fw-bold font-mono" style="color: var(--soc-neon-cyan) !important;"><%= mitreData.technique_id %></span>
                <small class="d-block text-secondary" style="font-size: 0.8rem;"><%= mitreData.technique_name %></small>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="p-2 rounded border border-secondary-subtle" style="background: var(--soc-bg-canvas);">
                <small class="text-secondary d-block font-mono">MITRE Tactic & CVSS</small>
                <span class="text-white fw-bold"><%= mitreData.tactic %></span>
                <small class="d-block text-warning font-mono" style="font-size: 0.8rem;">CVSS Base: <%= mitreData.cvss_score %></small>
              </div>
            </div>
          </div>

          <!-- Impact Assessment -->
          <div class="mb-4">
            <label class="soc-label">Operational Impact Assessment</label>
            <p class="text-secondary mb-0" style="font-size: 0.9rem;">
              <%= mitreData.impact %>
            </p>
          </div>

          <!-- Tactical Containment Playbook -->
          <div>
            <div class="d-flex justify-content-between align-items-center mb-1">
              <label class="soc-label mb-0">Tactical Containment Playbook:</label>
              <small class="text-secondary font-mono">One-Click Copy</small>
            </div>
            
            <div class="soc-terminal-block">
              <button class="soc-copy-btn" onclick="copyPlaybook(this)" title="Copy containment playbook to clipboard">
                <i class="fas fa-copy me-1"></i> Copy
              </button>
              <code class="soc-terminal-code" id="playbookCode"><%= mitreData.containment_playbook.join('\n') %></code>
            </div>
          </div>

        </div>
        <div class="soc-card-footer d-flex justify-content-between align-items-center">
          <small class="text-secondary">CERT/SOC Incident Protocol Aligned</small>
          <a href="/attacks" class="btn-soc btn-soc-secondary btn-sm"><i class="fas fa-book-bookmark me-1"></i> Framework Matrix</a>
        </div>
      </div>
    </div>

  </div>

  <!-- Action Navigation Bar -->
  <div class="soc-card p-4 mt-4 text-center">
    <div class="d-flex flex-wrap justify-content-center gap-3">
      <a href="/parameters" class="btn-soc btn-soc-primary">
        <i class="fas fa-sliders"></i> Modify Parameter Vector
      </a>
      <a href="/secrets" class="btn-soc btn-soc-secondary">
        <i class="fas fa-play"></i> Run Random Sample
      </a>
      <a href="/csv" class="btn-soc btn-soc-outline-cyan">
        <i class="fas fa-file-csv"></i> Batch CSV Triage
      </a>
      <a href="/submit" class="btn-soc btn-soc-secondary">
        <i class="fas fa-gauge-high"></i> Operations Dashboard
      </a>
    </div>
  </div>

</div>

<script>
function copyPlaybook(button) {
  const code = document.getElementById('playbookCode').innerText;
  navigator.clipboard.writeText(code).then(() => {
    button.innerHTML = '<i class="fas fa-check me-1"></i> Copied!';
    button.style.borderColor = 'var(--soc-emerald-safe)';
    button.style.color = 'var(--soc-emerald-safe)';
    setTimeout(() => {
      button.innerHTML = '<i class="fas fa-copy me-1"></i> Copy';
      button.style.borderColor = 'var(--soc-border-subtle)';
      button.style.color = 'var(--soc-text-secondary)';
    }, 2500);
  });
}
</script>

<%- include('partials/footer') %>
