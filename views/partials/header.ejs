<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Aegis SOC - Next-Gen Network Intrusion Detection System</title>
  
  <!-- Modern CDN Dependencies -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/css/soc-design-system.css">
  
  <!-- Chart.js for SOC Visualizations -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
</head>
<body>
  <!-- Accessible Keyboard Navigation Skip Link -->
  <a class="skip-to-content" href="#main-content">Skip to main content</a>

  <!-- Enterprise SOC Navbar -->
  <nav class="navbar navbar-expand-xl soc-navbar">
    <div class="container-fluid px-lg-4">
      <a class="navbar-brand" href="/">
        <i class="fas fa-shield-halved"></i>
        <span>AEGIS<span style="color: var(--soc-neon-cyan); font-weight: 400;">SOC</span></span>
      </a>

      <!-- Live Heartbeat Indicator -->
      <div class="d-none d-md-flex align-items-center ms-3">
        <div class="soc-system-status">
          <span class="soc-pulse-dot"></span>
          <span>SOC CONSOLE ACTIVE</span>
          <span class="text-secondary mx-1">|</span>
          <span style="color: var(--soc-neon-cyan);"><i class="fas fa-microchip me-1"></i>HYBRID ENGINE</span>
        </div>
      </div>

      <button class="navbar-toggler text-light border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#socNavbarNav" aria-controls="socNavbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <i class="fas fa-bars"></i>
      </button>

      <div class="collapse navbar-collapse" id="socNavbarNav">
        <ul class="navbar-nav ms-auto align-items-center">
          <li class="nav-item">
            <a class="nav-link soc-nav-link" href="/"><i class="fas fa-home"></i> Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link soc-nav-link" href="/submit"><i class="fas fa-gauge-high"></i> Operations</a>
          </li>
          <li class="nav-item">
            <a class="nav-link soc-nav-link" href="/parameters"><i class="fas fa-sliders"></i> Inspector</a>
          </li>
          <li class="nav-item">
            <a class="nav-link soc-nav-link" href="/csv"><i class="fas fa-file-csv"></i> Batch CSV</a>
          </li>
          <li class="nav-item">
            <a class="nav-link soc-nav-link" href="/stats"><i class="fas fa-chart-line"></i> Benchmark</a>
          </li>
          <li class="nav-item">
            <a class="nav-link soc-nav-link" href="/features"><i class="fas fa-list-check"></i> Features</a>
          </li>
          <li class="nav-item">
            <a class="nav-link soc-nav-link" href="/attacks"><i class="fas fa-crosshairs"></i> MITRE ATT&CK</a>
          </li>
          <li class="nav-item">
            <a class="nav-link soc-nav-link" href="/about"><i class="fas fa-circle-info"></i> About</a>
          </li>

          <!-- Auth Actions -->
          <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
            <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
              <a class="btn-soc btn-soc-secondary" href="/logout"><i class="fas fa-right-from-bracket"></i> Logout</a>
            <% } else { %>
              <a class="btn-soc btn-soc-primary" href="/login"><i class="fas fa-right-to-bracket"></i> Sign In</a>
            <% } %>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Main Content Wrapper -->
  <main id="main-content" class="flex-grow-1">