<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Aegis NIDS - Network Intrusion Detection System</title>
  
  <!-- Modern Dependencies -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/css/soc-design-system.css">
  
  <!-- Chart.js for Visualizations -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
</head>
<body>
  <!-- Accessible Skip Link -->
  <a class="skip-to-content" href="#main-content">Skip to main content</a>

  <!-- Modern Clean Navbar -->
  <nav class="navbar navbar-expand-xl soc-navbar">
    <div class="container-fluid px-lg-4">
      <a class="navbar-brand" href="/">
        <i class="fas fa-shield-halved"></i>
        <span>AEGIS <span class="text-sky fw-normal">NIDS</span></span>
      </a>

      <button class="navbar-toggler text-light border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#socNavbarNav" aria-controls="socNavbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <i class="fas fa-bars"></i>
      </button>

      <div class="collapse navbar-collapse" id="socNavbarNav">
        <ul class="navbar-nav ms-auto align-items-center">
          <li class="nav-item">
            <a class="nav-link soc-nav-link" href="/">Overview</a>
          </li>
          <li class="nav-item">
            <a class="nav-link soc-nav-link" href="/submit">Operations</a>
          </li>
          <li class="nav-item">
            <a class="nav-link soc-nav-link" href="/csv">Batch CSV</a>
          </li>
          <li class="nav-item">
            <a class="nav-link soc-nav-link" href="/parameters">Inspector</a>
          </li>
          <li class="nav-item">
            <a class="nav-link soc-nav-link" href="/stats">Benchmarks</a>
          </li>
          <li class="nav-item">
            <a class="nav-link soc-nav-link" href="/features">Features</a>
          </li>
          <li class="nav-item">
            <a class="nav-link soc-nav-link" href="/attacks">MITRE ATT&CK</a>
          </li>
          <li class="nav-item">
            <a class="nav-link soc-nav-link" href="/about">About</a>
          </li>

          <!-- Auth Actions -->
          <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
            <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
              <a class="btn-soc btn-soc-secondary btn-soc-sm" href="/logout"><i class="fas fa-right-from-bracket me-1"></i> Logout</a>
            <% } else { %>
              <a class="btn-soc btn-soc-primary btn-soc-sm" href="/login"><i class="fas fa-right-to-bracket me-1"></i> Sign In</a>
            <% } %>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Main Content Wrapper -->
  <main id="main-content" class="flex-grow-1">
