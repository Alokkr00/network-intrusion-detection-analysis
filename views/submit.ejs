<%- include('partials/header') %>

<div class="container-fluid px-lg-5 py-5">
  
  <!-- Operations Header -->
  <div class="text-center mb-5">
    <div class="d-inline-flex align-items-center gap-2 mb-2">
      <span class="soc-badge badge-glow-cyan"><i class="fas fa-terminal"></i> Tactical Operations Center</span>
      <span class="soc-badge badge-glow-safe"><i class="fas fa-circle-check"></i> All Models Active</span>
    </div>
    <h1 class="display-5 text-white fw-bold mb-2">Network Intrusion Detection Operations</h1>
    <p class="text-secondary" style="max-width: 600px; margin: 0 auto;">
      Select an intrusion triage modality below to assess live packet telemetry, execute batch traffic classification, or inspect custom signatures.
    </p>
  </div>

  <!-- Operational Mode Cards (12-Column Responsive Grid) -->
  <div class="row g-4 justify-content-center mb-5">
    
    <!-- Modality 1: Random Vector Triage -->
    <div class="col-lg-4 col-md-6">
      <div class="soc-card h-100">
        <div class="soc-card-header">
          <span class="soc-badge badge-glow-cyan"><i class="fas fa-dice"></i> Benchmark Vector</span>
          <small class="text-secondary font-mono">NSL-KDD Sample</small>
        </div>
        <div class="soc-card-body d-flex flex-column justify-content-between">
          <div>
            <div class="d-inline-flex p-3 rounded-circle mb-3" style="background: rgba(0, 240, 255, 0.1); color: var(--soc-neon-cyan);">
              <i class="fas fa-shuffle fa-2x"></i>
            </div>
            <h3 class="text-white mb-2">Random Sample Triage</h3>
            <p class="text-secondary" style="font-size: 0.95rem;">
              Stochastically draws a verified packet vector from the NSL-KDD test set and executes real-time multi-model inference across KNN, Random Forest, CNN, and LSTM.
            </p>
          </div>
          <div class="mt-4 pt-3 border-top border-secondary-subtle">
            <a href="/secrets" class="btn-soc btn-soc-primary w-100" id="runRandomBtn" onclick="this.innerHTML='<i class=\"fas fa-cog fa-spin\"></i> Sampling & Analyzing...'; this.classList.add('disabled');">
              <i class="fas fa-play"></i> Execute Random Triage
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Modality 2: Batch CSV Ingestion -->
    <div class="col-lg-4 col-md-6">
      <div class="soc-card h-100 soc-card-active">
        <div class="soc-card-header">
          <span class="soc-badge badge-glow-purple"><i class="fas fa-layer-group"></i> High Throughput</span>
          <small class="text-secondary font-mono">16 - 42 Columns</small>
        </div>
        <div class="soc-card-body d-flex flex-column justify-content-between">
          <div>
            <div class="d-inline-flex p-3 rounded-circle mb-3" style="background: rgba(139, 92, 246, 0.1); color: var(--soc-purple-model);">
              <i class="fas fa-file-csv fa-2x"></i>
            </div>
            <h3 class="text-white mb-2">Batch CSV Ingestion</h3>
            <p class="text-secondary" style="font-size: 0.95rem;">
              Upload network traffic datasets up to 50MB. Features drag-and-drop ingestion, client-side PapaParse pre-flight schema inspection, and automated annotated CSV export.
            </p>
          </div>
          <div class="mt-4 pt-3 border-top border-secondary-subtle">
            <a href="/csv" class="btn-soc btn-soc-primary w-100">
              <i class="fas fa-upload"></i> Open Ingestion Portal
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Modality 3: Custom Packet Parameters -->
    <div class="col-lg-4 col-md-6">
      <div class="soc-card h-100">
        <div class="soc-card-header">
          <span class="soc-badge badge-glow-warning"><i class="fas fa-sliders"></i> Targeted Forensics</span>
          <small class="text-secondary font-mono">Manual / Presets</small>
        </div>
        <div class="soc-card-body d-flex flex-column justify-content-between">
          <div>
            <div class="d-inline-flex p-3 rounded-circle mb-3" style="background: rgba(245, 158, 11, 0.1); color: var(--soc-amber-warning);">
              <i class="fas fa-crosshairs fa-2x"></i>
            </div>
            <h3 class="text-white mb-2">Packet Parameter Inspector</h3>
            <p class="text-secondary" style="font-size: 0.95rem;">
              Inspect specific Layer 4 protocol configurations, error frequencies, and destination host telemetry. Includes one-click presets for Neptune SYN Flood, Smurf, and Satan portscans.
            </p>
          </div>
          <div class="mt-4 pt-3 border-top border-secondary-subtle">
            <a href="/parameters" class="btn-soc btn-soc-secondary w-100">
              <i class="fas fa-sliders"></i> Configure Parameters
            </a>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Operational Metrics & Reference Navigation -->
  <div class="soc-card p-4">
    <div class="row align-items-center">
      <div class="col-md-8 text-center text-md-start mb-3 mb-md-0">
        <h5 class="text-white mb-1"><i class="fas fa-circle-nodes me-2" style="color: var(--soc-neon-cyan);"></i>Model Architecture & Performance Specs</h5>
        <p class="text-secondary mb-0" style="font-size: 0.9rem;">
          Inference is evaluated simultaneously across K-Nearest Neighbors, Random Forest ensemble, 1D Convolutional Neural Network, and Long Short-Term Memory recurrent network.
        </p>
      </div>
      <div class="col-md-4 text-center text-md-end">
        <a href="/stats" class="btn-soc btn-soc-outline-cyan">
          <i class="fas fa-chart-line"></i> View Model Benchmarks
        </a>
      </div>
    </div>
  </div>

</div>

<%- include('partials/footer') %>